# Contact form (quote page)
#
# Inbound mailbox for quote submissions — set this to whatever address should receive copies.
QUOTE_TO_EMAIL=
#
# Verified sender identity in Resend (must be a verified domain address in production).
# Until you verify a domain, Resend allows sending from:
# QUOTE_FROM_EMAIL=Acme <onboarding@resend.dev>
QUOTE_FROM_EMAIL=
#
# https://resend.com/docs/send-with-nextjs
RESEND_API_KEY=
