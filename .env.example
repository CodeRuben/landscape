# Contact form (quote page) — set all of these in production
#
# Google reCAPTCHA v3 (invisible score)
# Admin: https://www.google.com/recaptcha/admin — create a v3 key for this domain
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional — reject submissions below this (0–1). Default is 0.5
RECAPTCHA_MIN_SCORE=
#
# Resend email API: https://resend.com/docs/send-with-nextjs
# Until you verify a domain, Resend lets you send *to* your own signup email using:
# QUOTE_FROM_EMAIL=Acme <onboarding@resend.dev>
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
